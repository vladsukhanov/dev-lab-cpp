{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": { "CMAKE_EXPORT_COMPILE_COMMANDS": "ON" }
    },

    {
      "name": "tc-mingw-gcc",
      "hidden": true,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
        "VCPKG_HOST_TRIPLET": "x64-mingw-static"
      }
    },
    {
      "name": "tc-mingw-clang",
      "hidden": true,
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static",
        "VCPKG_HOST_TRIPLET": "x64-mingw-static"
      }
    },

    {
      "name": "type-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTS": "ON",
        "ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "type-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTS": "OFF"
      }
    },

    { "name": "debug-gcc",     "displayName": "Debug (MinGW gcc)",     "inherits": ["base", "tc-mingw-gcc",   "type-debug"] },
    { "name": "release-gcc",   "displayName": "Release (MinGW gcc)",   "inherits": ["base", "tc-mingw-gcc",   "type-release"] },
    { "name": "debug-clang",   "displayName": "Debug (MinGW clang)",   "inherits": ["base", "tc-mingw-clang", "type-debug"] },
    { "name": "release-clang", "displayName": "Release (MinGW clang)", "inherits": ["base", "tc-mingw-clang", "type-release"] }
  ],

  "buildPresets": [
    { "name": "debug-gcc",     "configurePreset": "debug-gcc" },
    { "name": "release-gcc",   "configurePreset": "release-gcc" },
    { "name": "debug-clang",   "configurePreset": "debug-clang" },
    { "name": "release-clang", "configurePreset": "release-clang" }
  ],

  "testPresets": [
    {
      "name": "debug-gcc",
      "configurePreset": "debug-gcc",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "debug-clang",
      "configurePreset": "debug-clang",
      "output": { "outputOnFailure": true }
    }
  ]
}